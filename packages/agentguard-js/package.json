{
  "name": "agentguard",
  "version": "0.3.0",
  "description": "Trace, evaluate, and judge LLM agents from JavaScript / TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Hamza Safwan",
    "url": "https://github.com/hamza-safwan"
  },
  "homepage": "https://github.com/hamza-safwan/AgentGuard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamza-safwan/AgentGuard.git",
    "directory": "packages/agentguard-js"
  },
  "keywords": [
    "agentguard",
    "llm",
    "agent",
    "evaluation",
    "tracing",
    "observability",
    "ci"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "codegen": "tsx scripts/codegen.ts ../../schemas/v1 src/schema.ts",
    "build": "npm run codegen && tsc",
    "test": "vitest run",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "json-schema-to-typescript": "^15.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.5.0"
  }
}
