{
  "$defs": {
    "AgentTrace": {
      "description": "Normalized record of a single agent run.\n\nv0.2 additions (additive): ``schema_version`` sanity field, ``runtime``\n(\"python\" / \"js\" / \"unknown\"), and ``sampling`` metadata set by the\nobservability SDK when a trace was head- or tail-sampled.",
      "properties": {
        "agent_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "agent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Version"
        },
        "final_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Output"
        },
        "runtime": {
          "default": "unknown",
          "enum": [
            "python",
            "js",
            "unknown"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "sampling": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TraceStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "total_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost Usd"
        },
        "total_latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Latency Ms"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "EvaluationResult": {
      "description": "Result of a single evaluator on a single scenario run.",
      "properties": {
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "score",
        "passed",
        "reason"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "TraceStep": {
      "description": "One step in an AgentTrace.\n\nv0.2 additions (all optional, additive): ``parent_step_id`` for nesting,\n``source`` to distinguish adapter-captured vs SDK-captured vs ingested,\n``redactions`` listing field paths that were scrubbed prior to serialization,\n``cost_usd`` per-step cost, ``tokens`` for LLM-call accounting.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "input": {
          "default": null,
          "title": "Input"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output": {
          "default": null,
          "title": "Output"
        },
        "parent_step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Step Id"
        },
        "redactions": {
          "items": {
            "type": "string"
          },
          "title": "Redactions",
          "type": "array"
        },
        "source": {
          "default": "adapter",
          "enum": [
            "adapter",
            "sdk",
            "ingest"
          ],
          "title": "Source",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "tokens": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "type": {
          "enum": [
            "llm_call",
            "tool_call",
            "retrieval",
            "guardrail",
            "handoff",
            "error",
            "final_output"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "$id": "https://schemas.agentguard.dev/v1/scenario_result.schema.json",
  "description": "Full scored result for one scenario.",
  "properties": {
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Usd"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/EvaluationResult"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "failure_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Summary"
    },
    "final_output": {
      "title": "Final Output",
      "type": "string"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "overall_score": {
      "title": "Overall Score",
      "type": "number"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "suite": {
      "title": "Suite",
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/AgentTrace"
    }
  },
  "required": [
    "scenario_id",
    "suite",
    "passed",
    "overall_score",
    "final_output",
    "evaluations",
    "trace"
  ],
  "title": "ScenarioResult",
  "type": "object"
}
